# Copy to .env for Docker Compose. Never commit real secrets.
APP_ENV=development
MYSQL_DATABASE=realestate_crm
MYSQL_USER=crm_app
MYSQL_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PORT=3306
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=realestate-crm-api
JWT_AUDIENCE=realestate-crm-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_IDLE_DAYS=7
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_DELIVERY=disabled
PUBLIC_WEB_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ALLOW_ORGANIZATION_REGISTRATION=true
MAX_UPLOAD_BYTES=10485760
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
UNIT_HOLD_EXPIRY_INTERVAL_SECONDS=30
WATCHPACK_POLLING=true
